<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Contact Us | Royal Tag</title>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0/css/all.min.css">
    <link rel="stylesheet" href="/css/styles.css">
    <style>
        .contact-page {
            max-width: 900px;
            margin: 60px auto;
            padding: 0 20px;
        }
        .contact-page h1 {
            font-size: 28px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            color: #002855;
            margin-bottom: 10px;
        }
        .contact-page h1::after {
            content: '';
            display: block;
            width: 50px;
            height: 3px;
            background-color: #002855;
            margin-top: 10px;
        }
        .contact-grid {
            display: flex;
            flex-wrap: wrap;
            gap: 40px;
            margin-top: 40px;
        }
        .contact-info {
            flex: 1;
            min-width: 250px;
        }
        .contact-info h2 {
            font-size: 16px;
            font-weight: 600;
            text-transform: uppercase;
            color: #002855;
            margin-bottom: 20px;
        }
        .contact-info p {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 14px;
            color: #444;
            margin-bottom: 16px;
        }
        .contact-info p i {
            color: #002855;
            width: 18px;
        }
        .contact-form {
            flex: 1;
            min-width: 280px;
        }
        .contact-form h2 {
            font-size: 16px;
            font-weight: 600;
            text-transform: uppercase;
            color: #002855;
            margin-bottom: 20px;
        }
        .contact-form input,
        .contact-form textarea {
            width: 100%;
            padding: 12px 15px;
            border: 1px solid #ddd;
            font-size: 14px;
            font-family: 'Poppins', sans-serif;
            margin-bottom: 14px;
            outline: none;
            transition: border 0.3s ease;
        }
        .contact-form input:focus,
        .contact-form textarea:focus {
            border-color: #002855;
        }
        .contact-form textarea {
            height: 130px;
            resize: vertical;
        }
        .contact-form button {
            background-color: #002855;
            color: #fff;
            border: none;
            padding: 12px 35px;
            font-size: 13px;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            cursor: pointer;
            transition: background-color 0.3s ease;
        }
        .contact-form button:hover {
            background-color: #1f3a37;
        }
        nav.contact-nav {
            background-color: #002855;
            padding: 12px 20px;
        }
        nav.contact-nav ul {
            display: flex;
            gap: 20px;
            list-style: none;
            max-width: 1600px;
            margin: 0 auto;
        }
        nav.contact-nav ul li a {
            color: #fff;
            font-size: 13px;
            font-weight: 600;
            text-transform: uppercase;
            text-decoration: none;
            transition: opacity 0.3s;
        }
        nav.contact-nav ul li a:hover {
            opacity: 0.75;
        }
    </style>
</head>
<body>
    <!-- Simple top nav matching teacher's example -->
    <nav class="contact-nav">
        <ul>
            <li><a href="/">Home</a></li>
            <li><a href="/contact-us">Contact Us</a></li>
        </ul>
    </nav>

    <!-- Contact Page Content -->
    <div class="contact-page">
        <h1>Contact Us</h1>

        <div class="contact-grid">
            <!-- Contact Info -->
            <div class="contact-info">
                <h2>Get In Touch</h2>
                <p><i class="fas fa-map-marker-alt"></i> 123 Eden Road, Lahore, Pakistan</p>
                <p><i class="fas fa-phone"></i> +92 300 1234567</p>
                <p><i class="fas fa-envelope"></i> support@royaltag.com.pk</p>
                <p><i class="fas fa-clock"></i> Mon–Sat | 9 AM – 9 PM</p>
            </div>

            <!-- Contact Form -->
            <div class="contact-form">
                <h2>Send a Message</h2>
                <input type="text" placeholder="Your Name">
                <input type="email" placeholder="Your Email">
                <textarea placeholder="Your Message"></textarea>
                <button type="submit">Send Message</button>
            </div>
        </div>
    </div>
</body>
</html>
