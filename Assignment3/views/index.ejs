            <div class="container">
                <!-- Slide 1 -->
                <div class="item">
                    <a href="/collections/the-heritage-summer-full-products-main">
                        <picture>
                            <img src="/images/main1.webp" alt="RoyalTag">
                        </picture>
                    </a>
                </div>
                
                <!-- Slide 2 -->
