        <!-- Dynamic Products Section -->
        <section class="product-block">
            <div class="container">
                <div class="halo-block-header">
                    <h3>Our Products</h3>
                </div>

                <!-- Filters -->
                <form method="GET" action="/products" style="margin-bottom: 20px; display: flex; gap: 10px; flex-wrap: wrap; justify-content: center;">
                    <input type="text" name="search" placeholder="Search..." value="<%= search %>" style="padding: 8px;">
                    <select name="category" style="padding: 8px;">
                        <option value="">All Categories</option>
                        <option value="Polo" <%= category === 'Polo' ? 'selected' : '' %>>Polo</option>
                        <option value="Casual" <%= category === 'Casual' ? 'selected' : '' %>>Casual</option>
                        <option value="Festive" <%= category === 'Festive' ? 'selected' : '' %>>Festive</option>
                    </select>
                    <input type="number" name="min" placeholder="Min Price" value="<%= min %>" style="padding: 8px; width: 100px;">
                    <input type="number" name="max" placeholder="Max Price" value="<%= max %>" style="padding: 8px; width: 100px;">
                    <select name="sort" style="padding: 8px;">
                        <option value="">Sort By</option>
                        <option value="price_asc" <%= sort === 'price_asc' ? 'selected' : '' %>>Price (Low to High)</option>
                        <option value="price_desc" <%= sort === 'price_desc' ? 'selected' : '' %>>Price (High to Low)</option>
                        <option value="rating_desc" <%= sort === 'rating_desc' ? 'selected' : '' %>>Rating (High to Low)</option>
                    </select>
                    <button type="submit" style="padding: 8px 15px; cursor: pointer; background: black; color: white; border: none;">Filter</button>
                </form>

                <div class="products-grid">
                    <% if (products.length === 0) { %>
                        <p style="text-align: center; width: 100%;">No products found.</p>
                    <% } else { %>
                        <% products.forEach((product, i) => { 
                            // Pick guaranteed working image numbers (1 to 3) to avoid missing .jpg/.webp errors!
                            let idx = (i % 3) + 1; 
                            let nextIdx = ((i + 1) % 3) + 1; // Guaranteed different image for hover!
                            
                            let imgPath1 = `/images/product${idx}.webp`;
                            let imgPath2 = `/images/product${nextIdx}.webp`;
                            
                            if (product.category === 'Casual') {
                                imgPath1 = `/images/causal-product${idx}.webp`;
                                imgPath2 = `/images/causal-product${nextIdx}.webp`;
                            } else if (product.category === 'Festive') {
                                imgPath1 = `/images/festive-product${idx}.webp`;
                                imgPath2 = `/images/festive-product${nextIdx}.webp`;
                            }
                        %>
                            <div class="product">
                                <div class="card">
                                    <div class="card-product">
                                        <div class="card__badge">
                                            <span class="badge new-badge">New</span>
                                        </div>
                                        <div class="card-media">
                                            <img src="<%= imgPath1 %>" alt="<%= product.name %>">
                                            <img src="<%= imgPath2 %>" alt="<%= product.name %>">
                                        </div>
                                        <a href="#" title="<%= product.name %>"></a>
                                        <ul class="sizes-list">
                                            <li><a href="#">M</a></li>
                                            <li><a href="#">L</a></li>
                                            <li><a href="#">XL</a></li>
                                        </ul>
                                    </div>
                                    <div class="card-information">
                                        <a class="card-title" href="#"><%= product.name %></a>
                                        <div class="card-price">
                                            <span class="price-item">Rs.<%= product.price %></span>
                                        </div>
                                        <!-- Fixed CSS clipping issue by overriding -webkit-line-clamp -->
                                        <div class="card-summary" style="-webkit-line-clamp: unset; max-height: none; overflow: visible;">
                                            <strong>Category:</strong> <%= product.category %> <br>
                                            <strong>Rating:</strong> <%= product.rating %> / 5 <br>
                                            <strong>Stock:</strong> <%= product.stock %>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        <% }) %>
                    <% } %>
                </div>
                
                <!-- Pagination -->
                <% if (totalPages > 1) { %>
                    <div class="pagination" style="text-align: center; margin-top: 30px; font-size: 16px;">
                        <% if (currentPage > 1) { %>
                            <a href="/products?page=<%= currentPage - 1 %>&search=<%= search %>&category=<%= category %>&min=<%= min %>&max=<%= max %>&sort=<%= sort %>" style="margin-right: 15px; color: black; text-decoration: underline;">Prev</a>
                        <% } %>
                        
                        <span>Page <%= currentPage %> of <%= totalPages %></span>

                        <% if (currentPage < totalPages) { %>
                            <a href="/products?page=<%= currentPage + 1 %>&search=<%= search %>&category=<%= category %>&min=<%= min %>&max=<%= max %>&sort=<%= sort %>" style="margin-left: 15px; color: black; text-decoration: underline;">Next</a>
                        <% } %>
                    </div>
                <% } %>

            </div>
        </section>

        <!-- Shop by Style Section -->
