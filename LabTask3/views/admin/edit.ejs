<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Edit Product</title>
    <style>
        body { font-family: sans-serif; padding: 20px; }
        .form-container { max-width: 500px; margin: 0 auto; padding: 20px; border: 1px solid #ddd; }
        .form-container input, .form-container select { width: 100%; padding: 8px; margin: 10px 0; box-sizing: border-box; }
        .btn { padding: 10px 15px; background: blue; color: white; border: none; cursor: pointer; width: 100%; }
        .error { color: red; }
    </style>
</head>
<body>
    <div class="form-container">
        <h2>Edit Product</h2>
        <% if (error) { %> <p class="error"><%= error %></p> <% } %>
        
        <form method="POST" action="/admin/products/edit/<%= product._id %>" enctype="multipart/form-data">
            <label>Name:</label>
            <input type="text" name="name" value="<%= product.name %>" required>

            <label>Price (Rs):</label>
            <input type="number" name="price" value="<%= product.price %>" required>

            <label>Category:</label>
            <select name="category" required>
                <option value="Polo" <%= product.category === 'Polo' ? 'selected' : '' %>>Polo</option>
                <option value="Casual" <%= product.category === 'Casual' ? 'selected' : '' %>>Casual</option>
                <option value="Festive" <%= product.category === 'Festive' ? 'selected' : '' %>>Festive</option>
                <option value="Accessories" <%= product.category === 'Accessories' ? 'selected' : '' %>>Accessories</option>
            </select>

            <label>Rating (1-5):</label>
            <input type="number" step="0.1" name="rating" value="<%= product.rating %>" required>

            <label>Stock:</label>
            <input type="number" name="stock" value="<%= product.stock %>" required>

            <label>Current Image:</label><br>
            <% if (product.image) { %>
                <img src="<%= product.image %>" width="100" style="margin-bottom:10px;"><br>
            <% } else { %>
                <p>No image uploaded</p>
            <% } %>

            <label>Upload New Image (Optional):</label>
            <input type="file" name="image" accept="image/*">

            <button type="submit" class="btn">Update Product</button>
        </form>
        <br>
        <a href="/admin" style="display: block; text-align: center; color: black;">Cancel</a>
    </div>
</body>
</html>
