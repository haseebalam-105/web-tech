<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Login | Royal Tag</title>
  <link rel="stylesheet" href="/css/styles.css">
  <style>
    body { background: #1a1a2e; min-height: 100vh; display: flex; align-items: center; justify-content: center; margin: 0; }
    .auth-card { background: #fff; border-radius: 12px; box-shadow: 0 4px 24px rgba(0,0,0,0.25); padding: 2.5rem 2rem; width: 100%; max-width: 420px; font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif; }
    .auth-logo { text-align: center; margin-bottom: 1.5rem; }
    .auth-logo .logo-circle { width: 72px; height: 72px; border-radius: 50%; border: 1px solid #ddd; display: flex; align-items: center; justify-content: center; margin: 0 auto 12px; font-size: 20px; font-weight: bold; color: #333; letter-spacing: 2px; }
    .auth-card h2 { text-align: center; font-size: 22px; color: #2c3e50; margin: 0 0 6px; }
    .auth-card p.subtitle { text-align: center; font-size: 13px; color: #7f8c8d; margin: 0 0 24px; }
    .auth-alert { padding: 10px 14px; border-radius: 6px; font-size: 13px; margin-bottom: 16px; }
    .auth-alert-error   { background: #fff0f0; color: #c0392b; border: 1px solid #f5c6c6; }
    .auth-alert-success { background: #f0fff4; color: #1e7e3e; border: 1px solid #b2dfdb; }
    .form-group { margin-bottom: 18px; }
    .form-group label { display: block; font-size: 13px; font-weight: 600; color: #2c3e50; margin-bottom: 6px; }
    .form-group input { width: 100%; padding: 11px 12px; border: 1px solid #81d4fa; border-radius: 6px; font-size: 14px; outline: none; box-sizing: border-box; transition: border-color 0.2s; }
    .form-group input:focus { border-color: #00b4d8; }
    .btn-submit { width: 100%; background: #00b4d8; color: #fff; border: none; padding: 12px; border-radius: 6px; font-size: 15px; font-weight: 700; cursor: pointer; transition: background 0.2s; margin-bottom: 16px; }
    .btn-submit:hover { background: #0096c7; }
    .auth-links { text-align: center; font-size: 13px; }
    .auth-links a { color: #00b4d8; text-decoration: none; }
    .auth-links a:hover { text-decoration: underline; }
  </style>
</head>
<body>
  <div class="auth-card">
    <div class="auth-logo">
      <div class="logo-circle">Z T</div>
      <h2>Welcome Back</h2>
      <p class="subtitle">Sign in to your account</p>
    </div>

    <% if (flashError && flashError.length > 0) { %>
      <div class="auth-alert auth-alert-error"><%= flashError[0] %></div>
    <% } %>
    <% if (flashSuccess && flashSuccess.length > 0) { %>
      <div class="auth-alert auth-alert-success"><%= flashSuccess[0] %></div>
    <% } %>

    <form method="POST" action="/login">
      <div class="form-group">
        <label for="email">Email Address</label>
        <input type="email" id="email" name="email" value="<%= old.email || '' %>" placeholder="you@example.com" required>
      </div>
      <div class="form-group">
        <label for="password">Password</label>
        <input type="password" id="password" name="password" placeholder="Your password" required>
      </div>
      <button type="submit" class="btn-submit">Login</button>
    </form>

    <div class="auth-links">
      <a href="/register">Don't have an account? Register</a><br><br>
      <a href="/">← Back to Store</a>
    </div>
  </div>
</body>
</html>
