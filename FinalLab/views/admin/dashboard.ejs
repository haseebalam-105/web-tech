<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Admin Dashboard</title>
    <link rel="stylesheet" href="/css/styles.css">
    <style>
        body { font-family: sans-serif; padding: 20px; }
        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
        table { width: 100%; border-collapse: collapse; margin-top: 20px; }
        th, td { border: 1px solid #ddd; padding: 10px; text-align: left; }
        th { background: #f4f4f4; }
        .btn { padding: 5px 10px; text-decoration: none; color: white; border: none; cursor: pointer; border-radius: 3px; }
        .btn-add { background: green; padding: 10px 15px; }
        .btn-edit { background: blue; }
        .btn-delete { background: red; }
        .action-btns { display: flex; gap: 10px; }
    </style>
</head>
<body>
    <div class="header">
        <h2>Admin Dashboard - Product Management</h2>
        <div>
            <% if (currentUser) { %><span style="margin-right:10px; font-size:14px;">👤 <%= currentUser.name %></span><% } %>
            <a href="/admin/products/new" class="btn btn-add">Add New Product</a>
            <a href="/logout" class="btn btn-delete">Logout</a>
            <a href="/" class="btn btn-edit" style="background: black;">View Store</a>
        </div>
    </div>

    <% if (flashError && flashError.length > 0) { %>
      <div style="background:#fff0f0;color:#c0392b;padding:10px 16px;border-radius:6px;margin-bottom:12px;font-size:13px;"><%= flashError[0] %></div>
    <% } %>
    <% if (flashSuccess && flashSuccess.length > 0) { %>
      <div style="background:#f0fff4;color:#1e7e3e;padding:10px 16px;border-radius:6px;margin-bottom:12px;font-size:13px;"><%= flashSuccess[0] %></div>
    <% } %>

    <table>
        <thead>
            <tr>
                <th>Image</th>
                <th>Name</th>
                <th>Category</th>
                <th>Price</th>
                <th>Stock</th>
                <th>Rating</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            <% products.forEach(product => { %>
                <tr>
                    <td>
                        <% if (product.image) { %>
                            <img src="<%= product.image %>" width="50" height="50" style="object-fit: cover;">
                        <% } else { %>
                            <span>No Image</span>
                        <% } %>
                    </td>
                    <td><%= product.name %></td>
                    <td><%= product.category %></td>
                    <td>Rs.<%= product.price %></td>
                    <td><%= product.stock %></td>
                    <td><%= product.rating %></td>
                    <td class="action-btns">
                        <a href="/admin/products/edit/<%= product._id %>" class="btn btn-edit">Edit</a>
                        <form method="POST" action="/admin/products/delete/<%= product._id %>" onsubmit="return confirm('Are you sure you want to delete this product?');" style="margin:0;">
                            <button type="submit" class="btn btn-delete">Delete</button>
                        </form>
                    </td>
                </tr>
            <% }) %>
        </tbody>
    </table>
</body>
</html>
